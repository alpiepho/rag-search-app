# For local supabase  
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=local_is_really_long
# SUPABASE_SERVICE_ROLE_KEY=local_is_really_long

# For local supabase on VM with docker
NEXT_PUBLIC_SUPABASE_URL=http://10.0.0.nn:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=local_is_really_long
SUPABASE_SERVICE_ROLE_KEY=local_is_really_long


# EMBEDDING_FORMAT can be 'openai' (v1/embeddings) or 'ollama' (api/embed)
# Default is 'openai'
EMBEDDING_FORMAT=ollama
# EMBEDDING_FORMAT=openai

# Ollama Configuration (REQUIRED)
OLLAMA_URL=http://10.0.0.nn:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# Docker Model Runner Configuration (REQUIRED)
# OLLAMA_URL=http://10.0.0.nn:12434
# EMBEDDING_MODEL=nomic-embed-text-v1.5
# CHAT_MODEL=llama3.1

